chuoi = input("Nhập chuỗi: ")

def tim_chuoi(chuoi):
    chuoi_moi = chuoi.split()

    index = []
    for i in range(len(chuoi_moi)):
        if chuoi_moi[i] == "Python":
            index.append(i)

    if len(index) > 0:
        return index

    chuoi_moi1 = chuoi.lower().split()
    index1 = []
    for i in range(len(chuoi_moi1)):
        if chuoi_moi1[i] == "python":
            index1.append(i)

    if len(index1) > 0:
        return -1

    return 0


ket_qua = tim_chuoi(chuoi)

if ket_qua == 0:
    print(0)
elif ket_qua == -1:
    print(-1)
else:
    print("Chuỗi 'Python' xuất hiện", len(ket_qua), "lần, tại các vị trí:", ket_qua)